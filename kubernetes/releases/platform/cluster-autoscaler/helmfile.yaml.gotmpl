# ============================================================
# cluster-autoscaler — ASG-based node autoscaler. MUTUALLY EXCLUSIVE with karpenter — installed when state.yaml nodeAutoscaler: cluster-autoscaler.
#
# Self-contained helmfile state. Deploy this tool alone:
#   helmfile -e dev --kube-context <ctx> -f kubernetes/releases/platform/cluster-autoscaler/helmfile.yaml.gotmpl sync   # from the repo root
#
# ⚠ Each folder is a SEPARATE state, so `needs` cannot reference a release in
#   another folder. Deploy ORDER lives in the root helmfile.yaml.gotmpl include
#   list — that list is load-bearing, this file must not encode cross-tool order.
# ============================================================
bases:
  - ../../../repositories.yaml
environments:
  dev:     { values: [ ../../../../environments/dev/kubernetes/state.yaml ], secrets: [ ../../../../environments/dev/kubernetes/secrets.enc.yaml ] }
  staging: { values: [ ../../../../environments/staging/kubernetes/state.yaml ], secrets: [ ../../../../environments/staging/kubernetes/secrets.enc.yaml ] }
  prod:    { values: [ ../../../../environments/prod/kubernetes/state.yaml ], secrets: [ ../../../../environments/prod/kubernetes/secrets.enc.yaml ] }

---
{{- $env := .Environment.Name }}

releases:
  - name: cluster-autoscaler
    namespace: kube-system
    chart: autoscaler/cluster-autoscaler
    version: 9.46.6
    # One node autoscaler per cluster: nodeAutoscaler in environments/<env>/kubernetes/state.yaml.
    installed: {{ eq (.Values | get "nodeAutoscaler" "none") "cluster-autoscaler" }}
    missingFileHandler: Error
    labels: { name: cluster-autoscaler, layer: platform, tier: infra, component: autoscaling, env: "{{ $env }}" }
    values:
      - ../../../../environments/{{ .Environment.Name }}/kubernetes/tools/cluster-autoscaler/values.yaml.gotmpl
