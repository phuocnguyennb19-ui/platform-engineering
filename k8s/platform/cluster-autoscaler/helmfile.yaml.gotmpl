# ============================================================
# cluster-autoscaler — ASG-based node autoscaler. MUTUALLY EXCLUSIVE with karpenter — off unless ENABLE_CLUSTER_AUTOSCALER=true.
#
# Self-contained helmfile state. Deploy this tool alone:
#   helmfile -e dev -f cluster-autoscaler/helmfile.yaml.gotmpl sync
#
# ⚠ Each folder is a SEPARATE state, so `needs` cannot reference a release in
#   another folder. Deploy ORDER lives in the root helmfile.yaml.gotmpl include
#   list — that list is load-bearing, this file must not encode cross-tool order.
# ============================================================
bases:
  - ../../../infra-base/k8s/env-values/environments.yaml
  - ../../../infra-base/k8s/env-values/repositories.yaml
environments:
  dev:     { secrets: [ ../../../infra-base/k8s/env-values/dev/secrets.enc.yaml ] }
  staging: { secrets: [ ../../../infra-base/k8s/env-values/staging/secrets.enc.yaml ] }
  prod:    { secrets: [ ../../../infra-base/k8s/env-values/prod/secrets.enc.yaml ] }

---
{{- $env := .Environment.Name }}

releases:
  - name: cluster-autoscaler
    namespace: kube-system
    chart: autoscaler/cluster-autoscaler
    version: 9.46.6
    installed: {{ eq (env "ENABLE_CLUSTER_AUTOSCALER" | default "false") "true" }}
    missingFileHandler: Warn
    labels: { name: cluster-autoscaler, layer: platform, tier: infra, component: autoscaling, env: "{{ $env }}" }
    values:
      - ../../../infra-base/k8s/platform/cluster-autoscaler/values.yaml.gotmpl
      - ../../../infra-base/k8s/platform/cluster-autoscaler/{{ .Environment.Name }}/values.yaml.gotmpl
