# ============================================================
# HashiCorp Vault — secrets management / dynamic secrets / PKI / transit
# Chart: hashicorp/vault · ns `vault`
#
# Topology:
#   dev/staging → HA Raft, 1 replica (integrated storage, still real Vault —
#                 NOT `-dev` mode, so data persists)
#   prod        → HA Raft, 3 replicas, anti-affinity, auto-unseal
#
# Unsealing (NEVER store unseal keys in git):
#   dev/staging → manual `vault operator init` + `unseal` (documented in README)
#   prod        → auto-unseal via AWS KMS / GCP KMS / Vault transit. Configure
#                 the `seal "awskms"` stanza below with an IRSA-annotated SA.
#
# Integrations:
#   - External Secrets Operator (already deployed) reads from Vault via a
#     SecretStore (see external-secrets/manifests/example-secretstore.yaml).
#   - Vault Agent Injector mutates pods to fetch secrets (enabled in prod).
#
# What lives where:
#   values.yaml.gotmpl → HA/raft, seal config, injector, ingress, metrics
#   Secret             → NONE at deploy time; Vault is the secret source of truth
#   files/            → server HCL via `server.ha.raft.config` (below)
# ============================================================

{{/* Auto-unseal (prod). Both MUST be provided or the seal stanza is omitted —
     a literal "<KMS_KEY_ID>" placeholder produces an HCL that Vault rejects at
     startup. Without them Vault comes up sealed and needs manual unsealing. */}}

{{/* TLS material issued by cert-manager into the Secret `vault-tls`
     (vault/manifests/certificate.yaml). The chart mounts `type: secret`
     extraVolumes under /vault/userconfig/<name>/. */}}

injector:
  metrics:
    enabled: true
  resources:
    requests: { cpu: 50m, memory: 128Mi }
    limits:   { cpu: 250m, memory: 256Mi }
  enabled: false              # Agent Injector only where apps consume it

server:
  image:
    repository: hashicorp/vault
    tag: "1.19.0"

  dataStorage:
    enabled: true
    size: 5Gi
    {{- if (.Values.storageClass) }}
    storageClass: {{ (.Values.storageClass) }}
    {{- end }}

  # IPC_LOCK: keep secrets off swap (why ns PSA=baseline, not restricted).
  extraSecurityContext:
    runAsNonRoot: true
    runAsUser: 100
    capabilities:
      add: [ IPC_LOCK ]
      drop: [ ALL ]

  # ── HA via integrated Raft storage ────────────────────────
  # ── HA via integrated Raft storage ────────────────────────
  ha:
    enabled: true
    raft:
      enabled: true
      setNodeId: true
      config: |
        ui = true
        listener "tcp" {
          address     = "[::]:8200"
          cluster_address = "[::]:8201"
          tls_disable = 1
        }
        storage "raft" {
          path = "/vault/data"
        {{- /* retry_join lets every peer find the cluster on restart. Without
               it a multi-replica Raft cluster never forms on its own and each
               pod has to be joined by hand after `vault operator init`. */}}
          retry_join {
            leader_api_addr = "http://vault-0.vault-internal:8200"
          }
        }
        service_registration "kubernetes" {}
        telemetry {
          prometheus_retention_time = "30s"
          disable_hostname = true
        }
    replicas: 1

  resources:
    requests: { cpu: 100m, memory: 256Mi }
    limits:   { cpu: 500m, memory: 512Mi }

# ── UI + Ingress ────────────────────────────────────────────
ui:
  enabled: true
  serviceType: ClusterIP

serverTelemetry:
  serviceMonitor:
    enabled: true
    selectors:
      release: kube-prometheus-stack
global:
  # dev: in-cluster HTTP (no cert to manage for a throwaway env).
  # staging/prod: TLS on, backed by the cert-manager Certificate below.
  tlsDisable: true

# Ingress lives on the injector/server via a plain Ingress object.
# (Chart's server.ingress.)
