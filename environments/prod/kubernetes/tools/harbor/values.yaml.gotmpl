# ============================================================
# Harbor — private container/OCI + Helm registry with image scanning
# Chart: harbor/harbor · ns `harbor`
#
# Reuses the shared platform stores (no bundled DB/cache/objectstore):
#   database → PostgreSQL   (release/postgresql, db `registry`)
#   cache    → Redis        (release/redis)
#   storage  → MinIO S3      (release/minio, bucket `harbor-registry`)
#   scanner  → bundled Trivy (also feeds cluster-wide trivy-operator context)
#
# Also serves as the Bitnami image mirror (proxy-cache project `bitnami`) so
# data-store charts can pin pull-through images — closing the Bitnami-2025 gap.
#
# What lives where:
#   values.yaml.gotmpl → expose/ingress, external DB/redis/S3 wiring, scanning
#   Secret (SOPS)      → admin password + external DB/redis/S3 credentials
#   config/            → n/a (Harbor is API/DB-driven post-install)
# ============================================================

fullnameOverride: harbor
externalURL: https://{{ (printf "harbor.%s" .Values.ingressDomain) }}

# ── Expose via Kong (IngressClass kong) ─────────────────────
expose:
  type: ingress
  tls:
    certSource: secret
    secret:
      secretName: harbor-tls
    enabled: true
  ingress:
    hosts:
      core: {{ (printf "harbor.%s" .Values.ingressDomain) }}
    className: {{ .Values.ingressClass }}
    annotations:
      # Kong. (was nginx ssl-redirect "true")
      konghq.com/protocols: "https"
      konghq.com/https-redirect-status-code: "308"
      # Image layers: no body limit (was nginx proxy-body-size "0") — deliberately NO
      # konghq.com/plugins: request-size-limit here, and no buffering: Kong buffers to its
      # prefix emptyDir (chart default 256Mi), which a multi-GB layer push/pull would
      # overflow and get the proxy pod evicted. Stream both directions instead.
      konghq.com/request-buffering: "false"
      konghq.com/response-buffering: "false"

# ── Admin password (SOPS) ───────────────────────────────────
existingSecretAdminPassword: harbor-admin
existingSecretAdminPasswordKey: password

# ── External PostgreSQL (shared) ────────────────────────────
# ── External PostgreSQL (shared) ────────────────────────────
database:
  type: external
  external:
    host: postgresql.database.svc.{{ .Values.clusterDomain }}
    port: "5432"
    username: appuser
    coreDatabase: registry
    # Same reasoning as redis below — avoid existingSecret so no cluster lookup
    # is needed at render time and the first install can bootstrap itself.
    password: {{ .Values.secrets.postgresql.password | quote }}
    sslmode: require

# ── External Redis (shared) ─────────────────────────────────
# ⚠ TOPOLOGY DIFFERS PER ENV. redis/values.yaml.gotmpl runs standalone in
#   dev/staging (Service `redis-master`) but replication + Sentinel in prod,
#   where the bitnami chart stops creating `redis-master` entirely. Harbor
#   supports Sentinel natively via addr=<sentinel hosts> + sentinelMasterSet.
#
# ⚠ NOT using `existingSecret` on purpose: the chart resolves it with
#   `lookup "v1" "Secret" ...` (_helpers.tpl:190), which returns nil whenever
#   there is no cluster (every `helm template` / `helmfile lint` run) and also
#   on first install, because the Secret would be created by this same release.
#   `password` is read straight from SOPS at render time instead — same
#   exposure as the extraDeploy Secret it replaces, minus the chicken-and-egg.
# ── External Redis (shared) ─────────────────────────────────
# ⚠ TOPOLOGY DIFFERS PER ENV. redis/values.yaml.gotmpl runs standalone in
#   dev/staging (Service `redis-master`) but replication + Sentinel in prod,
#   where the bitnami chart stops creating `redis-master` entirely. Harbor
#   supports Sentinel natively via addr=<sentinel hosts> + sentinelMasterSet.
#
# ⚠ NOT using `existingSecret` on purpose: the chart resolves it with
#   `lookup "v1" "Secret" ...` (_helpers.tpl:190), which returns nil whenever
#   there is no cluster (every `helm template` / `helmfile lint` run) and also
#   on first install, because the Secret would be created by this same release.
#   `password` is read straight from SOPS at render time instead — same
#   exposure as the extraDeploy Secret it replaces, minus the chicken-and-egg.
redis:
  type: external
  external:
    password: {{ .Values.secrets.redis.password | quote }}
    addr: redis.database.svc.{{ .Values.clusterDomain }}:26379
    sentinelMasterSet: mymaster

# ── Object storage: MinIO S3 (shared) ───────────────────────
# ── Object storage: MinIO S3 (shared) ───────────────────────
persistence:
  enabled: true
  imageChartStorage:
    type: s3
    disableredirect: true              # required for MinIO (no signed-redirect)
    s3:
      region: us-east-1
      bucket: harbor-registry
      regionendpoint: http://minio.database.svc.{{ .Values.clusterDomain }}:9000
      accesskey: harbor
      secretkey: {{ .Values.secrets.minio.harborSecretKey | quote }}
      secure: false
  # Component-level PVCs (jobservice logs, trivy cache, database if internal).
  # Component-level PVCs (jobservice logs, trivy cache, database if internal).
  persistentVolumeClaim:
    jobservice:
      jobLog:
        storageClass: {{ .Values.storageClass | quote }}
        size: 5Gi
    trivy:
      storageClass: {{ .Values.storageClass | quote }}
      size: 10Gi

# ── Vulnerability scanning ──────────────────────────────────
trivy:
  enabled: true
  offlineScan: false
  resources:
    requests: { cpu: 200m, memory: 512Mi }
    limits:   { cpu: 1,    memory: 1Gi }

# ── Metrics ─────────────────────────────────────────────────
metrics:
  enabled: true
  serviceMonitor:
    enabled: true
    additionalLabels:
      release: kube-prometheus-stack

# ── Secrets rendered from SOPS ──────────────────────────────
# Only the admin password still needs a standalone Secret: it is consumed via
# `existingSecretAdminPassword`, which the chart reads with a normal secretKeyRef
# (no `lookup`), so extraDeploy in the same release is safe here.
#
# The DB / Redis / S3 credentials moved INTO their own value blocks above —
# those paths went through `lookup "v1" "Secret"`, which cannot work during
# `helm template` or on a first install.
extraDeploy:
  - apiVersion: v1
    kind: Secret
    metadata: { name: harbor-admin, namespace: harbor }
    type: Opaque
    stringData:
      password: {{ .Values.secrets.harbor.adminPassword | quote }}

# ── Component replicas + resources ──────────────────────────
portal:
  replicas: 2
core:
  replicas: 2
  resources:
    requests: { cpu: 500m, memory: 1Gi }
    limits:   { cpu: 2, memory: 2Gi }
registry:
  replicas: 2
jobservice:
  replicas: 2

# ── Internal TLS between components (prod) ──────────────────
internalTLS:
  enabled: true
