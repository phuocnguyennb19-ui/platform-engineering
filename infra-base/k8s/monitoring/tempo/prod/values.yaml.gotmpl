# prod: only the values that differ per environment — layered after ../values.yaml.gotmpl

tempo:
  retention: 336h

  resources:
    requests: { cpu: 500m, memory: 1Gi }
    limits:   { cpu: 2, memory: 2Gi }

  storage:
    trace:
      backend: s3
      s3:
        bucket: tempo-traces-prod
        region: ap-southeast-1
        endpoint: s3.ap-southeast-1.amazonaws.com
        # Prefer IRSA/Workload Identity; inject static keys via SOPS secret only if unavoidable.

# Prometheus must accept remote_write from the metrics-generator.
# (kube-prometheus-stack sets enableRemoteWriteReceiver — see note in README.)

persistence:
  size: 30Gi
