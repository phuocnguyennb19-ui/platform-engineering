# ============================================================
# Local platform: what every app release needs before it can install.
#   helmfile -e local -f platform/helmfile.yaml.gotmpl sync
# ============================================================
bases:
  - ../defaults.yaml.gotmpl

---

repositories:
  - name: prometheus-community-oci
    url: ghcr.io/prometheus-community/charts
    oci: true

releases:
  # ServiceMonitor / PrometheusRule CRDs, which every app renders. Version matches
  # monitoring/kube-prometheus-stack 87.19.1 (prometheus-operator v0.92.1).
  - name: prometheus-operator-crds
    namespace: kube-system
    chart: prometheus-community-oci/prometheus-operator-crds
    version: 30.0.1
    labels: { name: prometheus-operator-crds, layer: platform }

  # Namespace `local` with Pod Security "restricted", as dev/staging/prod.
  - name: local-namespace
    namespace: kube-system
    chart: ./namespace
    labels: { name: local-namespace, layer: platform }
