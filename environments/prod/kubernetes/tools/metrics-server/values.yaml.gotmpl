# metrics-server — resource metrics API (powers HPA + kubectl top)

args:
  - --kubelet-preferred-address-types=InternalIP,Hostname,ExternalIP
  # Enable the line below if kubelet uses a self-signed cert (some kubeadm/on-prem clusters):
  # - --kubelet-insecure-tls

resources:
  requests: { cpu: 50m, memory: 128Mi }
  limits:   { cpu: 200m, memory: 256Mi }

# Expose metrics-server's own metrics to Prometheus.
serviceMonitor:
  enabled: true
replicas: 2
podDisruptionBudget:
  enabled: true
  minAvailable: 1
