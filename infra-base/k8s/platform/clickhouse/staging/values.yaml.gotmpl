# staging: only the values that differ per environment — layered after ../values.yaml.gotmpl

shards: 1
replicaCount: 1

persistence:
  size: 20Gi
  {{- if (.Values.storageClass) }}
  storageClass: {{ (.Values.storageClass) }}
  {{- end }}

resources:
  requests: { cpu: 500m, memory: 1Gi }
  limits:   { cpu: 1, memory: 2Gi }

# ── ClickHouse Keeper (Raft coordination, replaces ZooKeeper) ──
keeper:
  replicaCount: 1
  persistence:
    size: 5Gi
    {{- if (.Values.storageClass) }}
    storageClass: {{ (.Values.storageClass) }}
    {{- end }}

podAntiAffinityPreset: soft
pdb:
  create: false

networkPolicy:
  enabled: false
