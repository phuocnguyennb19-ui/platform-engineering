# ============================================================
# LOCAL root helmfile — laptop counterpart of k8s/helmfile.yaml.gotmpl.
# Only INCLUDES the per-folder states; DEPLOY ORDER IS THIS LIST (`needs`
# does not cross states). No AWS, no ECR, no SOPS, no Argo CD.
#
# Prerequisite — a running cluster with an `nginx` IngressClass and metrics-server:
#   minikube start --kubernetes-version=v1.32.12 --addons=ingress --addons=metrics-server
#   kubectl --context=minikube -n ingress-nginx rollout status deploy/ingress-nginx-controller --timeout=180s
# (the ingress admission webhook must answer before any Ingress can be created)
#
# Deploy (cd local):
#   helmfile -e local sync                                     # everything, in order
#   helmfile -e local -l layer=platform sync                   # CRDs + namespace only
#   helmfile -e local -l name=<app> sync                       # one app, by release name
#   helmfile -e local -l name=<app> template | diff | destroy
#   helm --kube-context=minikube test <app> -n local
#
# Add an app: give it applications/<app>/k8s/local/values.yaml. apps/helmfile.yaml.gotmpl
# finds every such folder; nothing is registered here.
# ============================================================

bases:
  - defaults.yaml.gotmpl

---

helmfiles:
  # CRDs (ServiceMonitor/PrometheusRule) and the `local` namespace before any app.
  - path: platform/helmfile.yaml.gotmpl

  # ── applications: every applications/<app>/k8s/local/values.yaml ──
  - path: apps/helmfile.yaml.gotmpl
