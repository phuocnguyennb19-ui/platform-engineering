# dev: only the values that differ per environment — layered after ../values.yaml.gotmpl

replicaCount: 1

resources:
  requests: { cpu: 100m, memory: 256Mi }
  limits:   { cpu: 500m, memory: 512Mi }

config:

  processors:
    # Guardrail against OOM under load — spill/refuse above the soft limit.
    memory_limiter:
      limit_mib: 400
      spike_limit_mib: 100
