# dev: only the values that differ per environment — layered after ../values.yaml.gotmpl

# ── Broker config: mounted as ConfigMap from files/server.properties ──
# Static tunables come from the file (readFile); env-sized durability knobs
# (replication factors / ISR / retention) are appended from the $size table.
extraConfig: |
{{ readFile "../files/server.properties" | indent 2 }}
  # ── env-sized durability (from $size) ──
  offsets.topic.replication.factor=1
  transaction.state.log.replication.factor=1
  transaction.state.log.min.isr=1
  default.replication.factor=1
  min.insync.replicas=1
  log.retention.hours=72

# ── Controllers ─────────────────────────────────────────────
controller:
  replicaCount: 1
  controllerOnly: false        # prod: dedicated controllers; non-prod: combined
  persistence:
    size: 10Gi
    {{- if (.Values.storageClass) }}
    storageClass: {{ (.Values.storageClass) }}
    {{- end }}
  resources:
    requests: { cpu: 250m, memory: 512Mi }
    limits:   { cpu: 1, memory: 1Gi }
  podAntiAffinityPreset: soft
  pdb:
    create: false

# ── Brokers (prod only — non-prod uses combined controllers) ─
broker:
  replicaCount: 0                      # combined mode: controllers serve as brokers

networkPolicy:
  enabled: false
