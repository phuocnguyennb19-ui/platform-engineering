# prod: only the values that differ per environment — layered after ../values.yaml.gotmpl

# ── HA (prod) ───────────────────────────────────────────────
replicaCount: 2

networkPolicy:
  enabled: true

podDisruptionBudget:
  enabled: true
  minAvailable: 1
affinity:
  podAntiAffinity:
    preferredDuringSchedulingIgnoredDuringExecution:
      - weight: 100
        podAffinityTerm:
          topologyKey: kubernetes.io/hostname
          labelSelector:
            matchLabels:
              app.kubernetes.io/name: sealed-secrets
