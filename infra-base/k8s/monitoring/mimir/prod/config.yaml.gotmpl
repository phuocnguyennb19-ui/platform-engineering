# prod: only the values that differ per environment — layered after ../config.yaml.gotmpl

mimir:
  structuredConfig:

    limits:
      # Retention of shipped blocks in object store (compactor enforces).
      compactor_blocks_retention_period: 8760h
      # Ingestion guardrails (tune per fleet size).
      ingestion_rate: 100000
      ingestion_burst_size: 200000
      max_global_series_per_user: 5000000
      max_query_lookback: 8760h

    compactor:
      compaction_interval: 30m
