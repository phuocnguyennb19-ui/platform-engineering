# cert-manager — TLS certificate automation

# Install cert-manager's own CRDs (Certificate, Issuer, ClusterIssuer...).
crds:
  enabled: true
  keep: true
resources:
  requests: { cpu: 50m, memory: 128Mi }
  limits:   { cpu: 200m, memory: 256Mi }

webhook:
  resources:
    requests: { cpu: 20m, memory: 64Mi }
    limits:   { cpu: 100m, memory: 128Mi }

cainjector:
  resources:
    requests: { cpu: 20m, memory: 128Mi }
    limits:   { cpu: 100m, memory: 256Mi }

# Ship metrics to Prometheus.
prometheus:
  enabled: true
  servicemonitor:
    enabled: true

# ── ClusterIssuers ──────────────────────────────────────────
# The cert-manager chart creates no issuers of its own, so they ride along as
# extraObjects. This keeps them in the same release (installed only after the
# CRDs and the webhook are Ready) instead of a manual `kubectl apply` that is
# easy to forget on a new cluster. clusterissuer.yaml was folded in here.
#
# ⚠ THE SOLVER INGRESS CLASS IS PER-ENV. It used to be hardcoded to
#   `nginx-prod` in BOTH issuers, so ACME HTTP-01 challenges in dev/staging
#   were routed to an IngressClass that does not exist there
#   (ingress-nginx creates nginx-<env>) and never validated. It now
#   follows .Values.ingressClass from environments/environments.yaml.
#
# Point an Ingress at one with:
#   annotations:
#     cert-manager.io/cluster-issuer: letsencrypt-prod
#
# Use letsencrypt-staging while wiring things up — the production ACME endpoint
# rate-limits to 5 duplicate certificates per week per exact name set.
extraObjects:
  - |
    apiVersion: cert-manager.io/v1
    kind: ClusterIssuer
    metadata:
      name: letsencrypt-staging
    spec:
      acme:
        server: https://acme-staging-v02.api.letsencrypt.org/directory
        email: {{ env "ACME_EMAIL" | default "platform@example.com" | quote }}
        privateKeySecretRef:
          name: letsencrypt-staging-account-key
        solvers:
          - http01:
              ingress:
                ingressClassName: {{ .Values.ingressClass | quote }}
  - |
    apiVersion: cert-manager.io/v1
    kind: ClusterIssuer
    metadata:
      name: letsencrypt-prod
    spec:
      acme:
        server: https://acme-v02.api.letsencrypt.org/directory
        email: {{ env "ACME_EMAIL" | default "platform@example.com" | quote }}
        privateKeySecretRef:
          name: letsencrypt-prod-account-key
        solvers:
          - http01:
              ingress:
                ingressClassName: {{ .Values.ingressClass | quote }}
