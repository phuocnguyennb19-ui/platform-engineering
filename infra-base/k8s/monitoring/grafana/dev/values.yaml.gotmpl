# dev: only the values that differ per environment — layered after ../values.yaml.gotmpl

resources:
  requests: { cpu: 100m, memory: 128Mi }
  limits:   { cpu: 500m, memory: 256Mi }

# ── Persistence ─────────────────────────────────────────────
persistence:
  size: 5Gi

# ── High Availability & Scheduling (Prod) ───────────────────

# ── Ingress ─────────────────────────────────────────────────
ingress:
  annotations:
    nginx.ingress.kubernetes.io/ssl-redirect: "false"
    nginx.ingress.kubernetes.io/force-ssl-redirect: "false"
