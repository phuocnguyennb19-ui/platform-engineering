# staging: only the values that differ per environment — layered after ../values.yaml.gotmpl

# ── DB-less ─────────────────────────────────────────────────
env:
  log_level: info

# ── Proxy (data plane) ──────────────────────────────────────
proxy:
  # ⚠ dev MUST NOT be LoadBalancer. helmDefaults sets `wait: true`, and helm's
  #   wait blocks until a LoadBalancer Service is given an external IP. kind and
  #   minikube ship no LB provider, so `status.loadBalancer` stays `{}`, the
  #   release runs to the 900s timeout and is marked FAILED — while Kong itself
  #   is 2/2 Running and serving traffic. The failure looks like a broken chart
  #   and is really a missing cloud controller.
  #   Matches docs/DEPLOY.md §4 (local → NodePort / port-forward).
  #   For real LB behaviour at dev: `minikube tunnel` or the metallb addon.
  type: LoadBalancer
  http:
    enabled: false              # non-dev terminates TLS only
  # Only annotate where a real LB exists. At dev this would publish an A record
  # for api.<domain> pointing at a Service that never gets an address.
  annotations:
    external-dns.alpha.kubernetes.io/hostname: "api.{{ .Values.ingressDomain }}"

replicaCount: 2
resources:
  requests: { cpu: 200m, memory: 512Mi }
  limits:   { cpu: 1, memory: 1Gi }

autoscaling:
  enabled: false
  minReplicas: 2
  maxReplicas: 3

podDisruptionBudget:
  enabled: false
