# ============================================================
# karpenter — node autoscaler. NodePool/EC2NodeClass CRs live in manifests/ (kubectl apply after sync).
#
# Self-contained helmfile state. Deploy this tool alone:
#   helmfile -e dev -f karpenter/helmfile.yaml.gotmpl sync
#
# ⚠ Each folder is a SEPARATE state, so `needs` cannot reference a release in
#   another folder. Deploy ORDER lives in the root helmfile.yaml.gotmpl include
#   list — that list is load-bearing, this file must not encode cross-tool order.
# ============================================================
bases:
  - ../../../infra-base/k8s/env-values/environments.yaml
  - ../../../infra-base/k8s/env-values/repositories.yaml
environments:
  dev:     { secrets: [ ../../../infra-base/k8s/env-values/dev/secrets.enc.yaml ] }
  staging: { secrets: [ ../../../infra-base/k8s/env-values/staging/secrets.enc.yaml ] }
  prod:    { secrets: [ ../../../infra-base/k8s/env-values/prod/secrets.enc.yaml ] }

---
{{- $env := .Environment.Name }}

releases:
  - name: karpenter
    namespace: kube-system
    chart: oci://public.ecr.aws/karpenter/karpenter
    version: 1.14.0
    # Off until terraform/stacks/core provides its controller role, node role,
    # interruption queue and discovery tags — none exist yet, and a controller
    # without them never becomes ready, which fails the whole `helmfile sync`.
    installed: {{ eq (env "ENABLE_KARPENTER" | default "false") "true" }}
    missingFileHandler: Warn
    labels: { name: karpenter, layer: platform, tier: infra, component: autoscaling, env: "{{ $env }}" }
    values:
      - ../../../infra-base/k8s/platform/karpenter/values.yaml.gotmpl
      - ../../../infra-base/k8s/platform/karpenter/{{ .Environment.Name }}/values.yaml.gotmpl
