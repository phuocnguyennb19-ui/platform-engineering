# ============================================================
# Common settings for PROD environment
# Applied to all applications in production
# ============================================================

global:
  # this environment's ECR (terraform/stacks/registry). Plain YAML because
  # Argo CD reads this file too; deploy jobs refuse to run while REPLACE_WITH_ remains.
  imageRegistry: "REPLACE_WITH_PRODUCTION_AWS_ACCOUNT_ID.dkr.ecr.ap-southeast-1.amazonaws.com"

# ── Ingress ──────────────────────────────────────────────────
ingress:
  enabled: true
  className: nginx-prod
  annotations:
    # Security headers set globally at the ingress controller (addHeaders) —
    # per-Ingress configuration-snippet is DISABLED for prod-security.
    nginx.ingress.kubernetes.io/ssl-redirect: "true"
    nginx.ingress.kubernetes.io/proxy-body-size: "8m"
    # Auto-issue TLS via cert-manager. The ClusterIssuer ships with the
    # cert-manager release (cert-manager/values.yaml.gotmpl extraObjects).
    cert-manager.io/cluster-issuer: "letsencrypt-prod"

  # ⚠ hosts + tls are set PER SERVICE, in <svc>/values.yaml.gotmpl — this
  #   file cannot know the hostnames. cert-manager only issues a certificate
  #   when a `tls:` block exists; with ssl-redirect on and no tls, nginx sends
  #   HTTP → HTTPS to a listener with no certificate and every request fails
  #   with an SSL error. Each service that sets ingress.enabled must therefore
  #   set BOTH:
  #     hosts:
  #       - host: <svc>.example.com
  #         paths: [ { path: /, pathType: Prefix } ]
  #     tls:
  #       - secretName: <svc>-tls
  #         hosts: [ "<svc>.example.com" ]
  #   (be-payment and be-user do; be-notification disables ingress entirely.)

# ── Network Policy ────────────────────────────────────────────
networkPolicy:
  enabled: true
  policyTypes:
    - Ingress
    - Egress
  ingress:
    enabled: true
    # ⚠ REQUIRED. Once this rule carries a `from` list, ONLY those peers are
    #   allowed — same-namespace traffic is NOT implicit. Without this every
    #   in-cluster call between prod services (be-payment → be-notification,
    #   be-user → be-notification) is silently dropped by the CNI.
    #   network-policies/manifests/30-application.yaml now ships a namespace-wide
    #   allow-intra-namespace that would compensate, but do NOT rely on it: it is
    #   applied by kubectl at the end of a build, not by this release.
    allowSameNamespace: true
    # ingress-nginx runs in ns `infra` (ingress-nginx/helmfile.yaml.gotmpl), NOT in a
    # namespace called `ingress-nginx` — that selector matched nothing and the
    # rule was dead. It is set once, for every env, as
    # networkPolicy.ingress.fromIngressNamespace in common.yaml.gotmpl.
    #
    # Prometheus scrapes the app's /metrics from ns `observability`. Without it
    # every ServiceMonitor in the app tier silently reports "down".
    fromNamespaces:
      - observability
    ports:
      - protocol: TCP
        port: 8080
      - protocol: TCP
        port: 9090      # metrics
  egress:
    enabled: true
    # Structured knobs replace the hand-written DNS/same-namespace rules the
    # chart now generates itself.
    allowSameNamespace: true
    dns:
      enabled: true
    toNamespaces:
      # ── Data stores (all live in ns `database`) ──
      # network-policies/manifests/20-database.yaml has the matching ingress rule
      # (the `postgresql` / `redis` / `kafka` workload rules) on the `database` side; both are required.
      - namespace: database
        ports:
          - protocol: TCP
            port: 5432      # postgresql
          - protocol: TCP
            port: 6379      # redis
          - protocol: TCP
            port: 26379     # redis sentinel (prod topology)
          - protocol: TCP
            port: 9092      # kafka
          - protocol: TCP
            port: 9000      # minio S3
      # ── Telemetry → OpenTelemetry Collector ──
      - namespace: observability
        ports:
          - protocol: TCP
            port: 4317      # OTLP gRPC
          - protocol: TCP
            port: 4318      # OTLP HTTP
    # ── External HTTPS ──
    # RFC1918 excluded so this cannot be used to reach other in-cluster or
    # in-VPC services sideways; those need an explicit rule above.
    allowExternalHTTPS: true
    customRules:
      # Kubernetes API
      - to:
          - ipBlock:
              cidr: 10.96.0.1/32
        ports:
          - protocol: TCP
            port: 443

# ── Scaling ───────────────────────────────────────────────────
replicaCount: 3

autoscaling:
  enabled: true
  minReplicas: 3
  maxReplicas: 10
  targetCPUUtilizationPercentage: 75
  targetMemoryUtilizationPercentage: 80
  # Anti-flapping. Scale up fast, scale down slowly: without a stabilization
  # window a spiky prod service oscillates between 3 and 10 replicas, which
  # costs money and drops in-flight connections on every scale-down.
  behavior:
    scaleDown:
      stabilizationWindowSeconds: 300
      policies:
        - { type: Percent, value: 50, periodSeconds: 60 }
    scaleUp:
      stabilizationWindowSeconds: 0
      policies:
        - { type: Percent, value: 100, periodSeconds: 30 }
        - { type: Pods, value: 4, periodSeconds: 30 }
      selectPolicy: Max

# ── Resources ─────────────────────────────────────────────────
# No CPU limit by design: CPU is compressible and a limit only adds CFS
# throttling on latency-sensitive request paths. Memory IS limited because it is
# not compressible — the alternative to an OOMKill is a node-wide eviction
# cascade. Matches kyverno require-requests-limits, which requires
# requests.cpu/memory + limits.memory and deliberately omits limits.cpu.
resources:
  requests:
    cpu: 200m
    memory: 512Mi
  limits:
    memory: 1Gi

# ── Availability ──────────────────────────────────────────────
# minAvailable: 1 on a 3-replica service only guarantees one survivor; the
# drain can still take two of three at once. With replicaCount 3 / HPA min 3,
# maxUnavailable: 1 is the stronger statement and keeps drains unblocked.
podDisruptionBudget:
  enabled: true
  maxUnavailable: 1
  # Never let a permanently-broken pod block a node drain.
  unhealthyPodEvictionPolicy: AlwaysAllow

topologySpreadConstraints:
  - maxSkew: 1
    topologyKey: kubernetes.io/hostname
    whenUnsatisfiable: DoNotSchedule
  - maxSkew: 1
    topologyKey: topology.kubernetes.io/zone
    whenUnsatisfiable: ScheduleAnyway

# ── Security ──────────────────────────────────────────────────
serviceAccount:
  automountServiceAccountToken: false

podSecurityContext:
  runAsNonRoot: true
  runAsUser: 10001
  runAsGroup: 10001
  fsGroup: 10001
  seccompProfile:
    type: RuntimeDefault

securityContext:
  allowPrivilegeEscalation: false
  readOnlyRootFilesystem: true
  runAsNonRoot: true
  runAsUser: 10001
  capabilities:
    drop:
      - ALL

# ── Volumes ───────────────────────────────────────────────────
extraVolumes:
  - name: tmp
    emptyDir:
      medium: Memory
      sizeLimit: 128Mi

extraVolumeMounts:
  - name: tmp
    mountPath: /tmp

# ── Graceful Shutdown ─────────────────────────────────────────
terminationGracePeriodSeconds: 60

lifecycle:
  preStop:
    exec:
      command: ["/bin/sh", "-c", "sleep 5"]
