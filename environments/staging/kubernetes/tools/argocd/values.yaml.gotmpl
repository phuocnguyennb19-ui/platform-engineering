# ============================================================
# Argo CD — GitOps Continuous Delivery Values Template
# ============================================================

global:
  domain: argocd.{{ .Values.ingressDomain }}

configs:
  params:
    # TLS terminated at ingress -> run server in insecure (HTTP) mode behind it.
    server.insecure: true
  cm:
    exec.enabled: "false"
    application.instanceLabelKey: argocd.argoproj.io/instance
    # ── Local admin account ──────────────────────────────────────────────
    # Enabled in dev/staging for convenience. DISABLED in prod: the built-in
    # admin is a shared, non-attributable, non-revocable credential with full
    # cluster-admin reach through Argo, and it bypasses the SSO audit trail.
    #
    # ⚠ Configure SSO (dex.config / oidc.config) BEFORE the first prod sync —
    #   with admin disabled and no SSO configured, nobody can log in. Recover
    #   by flipping this back to "true" and restarting argocd-server.
    admin.enabled: "true"
  # Registers this cluster under its environment. The platform-apps ApplicationSet
  # generates Applications only for the environment of the cluster it runs in,
  # so one cluster never deploys another environment's apps.
  # Registers this cluster under its environment. The platform-apps ApplicationSet
  # generates Applications only for the environment of the cluster it runs in,
  # so one cluster never deploys another environment's apps.
  clusterCredentials:
    in-cluster:
      server: https://kubernetes.default.svc
      config: {}
      labels:
        platform.example.com/environment: "staging"
        platform.example.com/auto-sync: "true"

# secret-init Job creates the argocd-redis Secret (auth). Enable when registry egress is OK.
# Only disable when the network blocks quay.io → then create the argocd-redis secret manually:
#   kubectl -n infra create secret generic argocd-redis --from-literal=auth=$(openssl rand -base64 24)
redisSecretInit:
  enabled: true

# Application controller — keep 1 replica unless sharding is enabled.
controller:
  replicas: 1
  resources:
    requests: { cpu: 250m, memory: 512Mi }
    limits:   { cpu: "1", memory: 1Gi }
  metrics:
    enabled: true
    serviceMonitor:
      enabled: true

repoServer:
  resources:
    requests: { cpu: 100m, memory: 256Mi }
    limits:   { cpu: 500m, memory: 512Mi }
  metrics:
    enabled: true
    serviceMonitor:
      enabled: true
  replicas: 1
  autoscaling:
    enabled: true
    minReplicas: 1
    maxReplicas: 3

server:
  resources:
    requests: { cpu: 100m, memory: 128Mi }
    limits:   { cpu: 500m, memory: 256Mi }
  metrics:
    enabled: true
    serviceMonitor:
      enabled: true
  ingress:
    enabled: true
    annotations:
      # Backend is plain HTTP (configs.params server.insecure: true) — Kong's default
      # upstream protocol, so no konghq.com/protocol on the Service (was nginx
      # backend-protocol: HTTP). The argocd CLI needs --grpc-web through the proxy.
      # Kong: HTTPS only, plain HTTP → 308 (was nginx ssl-redirect "true"); 8 MB body limit
      # (was ingress-nginx proxy-body-size 8m, controller-wide) — KongClusterPlugin in
      # kubernetes/releases/platform/kong/manifests/plugins.yaml.
      konghq.com/protocols: "https"
      konghq.com/https-redirect-status-code: "308"
      konghq.com/plugins: "request-size-limit"
      cert-manager.io/cluster-issuer: letsencrypt-staging
    hostname: argocd.{{ .Values.ingressDomain }}
    tls: true
    ingressClassName: {{ .Values.ingressClass }}   # kong — state.yaml
  replicas: 1

applicationSet:
  metrics:
    enabled: true
    serviceMonitor:
      enabled: true
  replicas: 1

notifications:
  metrics:
    enabled: true
    serviceMonitor:
      enabled: true

# Prod: Redis HA (3 nodes + sentinel). Dev/staging: standalone redis.
redis:
  enabled: true
redis-ha:
  enabled: false
