# dev: only the values that differ per environment — layered after ../values.yaml.gotmpl

mode: standalone
replicas: 1

# ── Persistence ─────────────────────────────────────────────
persistence:
  size: 20Gi

resources:
  requests: { cpu: 100m, memory: 512Mi }
  limits:   { cpu: 500m, memory: 1Gi }
consoleIngress:
  annotations:
    nginx.ingress.kubernetes.io/ssl-redirect: "false"
