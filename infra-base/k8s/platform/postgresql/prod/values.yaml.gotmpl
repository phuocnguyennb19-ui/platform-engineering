# prod: only the values that differ per environment — layered after ../values.yaml.gotmpl

architecture: replication

# ── Primary ─────────────────────────────────────────────────
primary:
  persistence:
    size: 100Gi
    {{- if (.Values.storageClass) }}
    storageClass: {{ (.Values.storageClass) }}
    {{- end }}
  resources:
    requests: { cpu: 500m, memory: 1Gi }
    limits:   { cpu: 2, memory: 4Gi }
  # ── Custom config: mounted as ConfigMap from files/ (not inlined) ──
  # extendedConfiguration → conf.d/override.conf ; pgHbaConfiguration → pg_hba.conf.
  # The static hardening/logging/WAL block lives in files/postgresql.conf;
  # only the memory-sized knobs are appended per-env from the $size table.
  extendedConfiguration: |
{{ readFile "../files/postgresql.conf" | indent 4 }}
    # ── env-sized (from $size) ──
    max_connections = 300
    shared_buffers = 1GB
    effective_cache_size = 3GB
    ssl = on
  pdb:
    create: true
  podAntiAffinityPreset: hard

# ── Read replicas (prod, streaming replication) ─────────────
readReplicas:
  replicaCount: 2
  persistence:
    enabled: true
    size: 100Gi
    {{- if (.Values.storageClass) }}
    storageClass: {{ (.Values.storageClass) }}
    {{- end }}
  resources:
    requests: { cpu: 500m, memory: 1Gi }
    limits:   { cpu: 2, memory: 4Gi }
  pdb:
    create: true
    maxUnavailable: 1
