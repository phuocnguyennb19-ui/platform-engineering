# ============================================================
# smoke-test — one charts/application release (podinfo).
#   helmfile -e local -l name=smoke-test sync
#   helmfile -e local -f apps/smoke-test/helmfile.yaml.gotmpl sync
#
# Values, in order — the layers the Argo CD ApplicationSet uses in the cloud,
# with the local layers in place of env-values/<env> and values-<env>.yaml:
#   infra-base/k8s/env-values/app-values.yaml.gotmpl   shared app defaults (security, netpol)
#   local/values/app-values.yaml            local environment layer
#   applications/smoke-test/k8s/values.yaml  the app itself, as deployed in the cloud
#   values.yaml.gotmpl                      local overrides for this app
# ============================================================
bases:
  - ../../defaults.yaml.gotmpl

---

releases:
  - name: smoke-test
    namespace: {{ .Values.namespace }}
    chart: ../../../k8s/charts/application
    labels: { name: smoke-test, layer: app }
    values:
      - ../../../infra-base/k8s/env-values/app-values.yaml.gotmpl
      - ../../values/app-values.yaml
      - ../../../applications/smoke-test/k8s/values.yaml
      - values.yaml.gotmpl
