# staging: only the values that differ per environment — layered after ../values.yaml.gotmpl

resources:
  requests: { cpu: 100m, memory: 256Mi }
  limits:   { cpu: 500m, memory: 512Mi }

# ── Persistence ─────────────────────────────────────────────
persistence:
  size: 5Gi

# ── App Hardening (grafana.ini) ─────────────────────────────
grafana.ini:
  security:
    cookie_secure: true
    cookie_samesite: strict
    strict_transport_security: true
    strict_transport_security_max_age_seconds: 31536000

# ── High Availability & Scheduling (Prod) ───────────────────

# ── Ingress ─────────────────────────────────────────────────
ingress:
  annotations:
    nginx.ingress.kubernetes.io/ssl-redirect: "true"
    nginx.ingress.kubernetes.io/force-ssl-redirect: "true"
  tls:
    - secretName: grafana-tls
      hosts: [ "grafana.{{ .Values.ingressDomain }}" ]
