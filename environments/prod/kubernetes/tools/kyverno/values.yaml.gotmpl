# Kyverno — policy admission controller

# Kyverno CRDs (ClusterPolicy, Policy...).
crds:
  install: true

# The admission controller needs >=3 replicas for HA in prod (it's on the request path).
# The admission controller needs >=3 replicas for HA in prod (it's on the request path).
admissionController:
  resources:
    requests: { cpu: 100m, memory: 256Mi }
    limits:   { cpu: 500m, memory: 512Mi }
  serviceMonitor:
    enabled: true
  replicas: 3

backgroundController:
  serviceMonitor:
    enabled: true
  replicas: 2

reportsController:
  serviceMonitor:
    enabled: true
  replicas: 2

cleanupController:
  serviceMonitor:
    enabled: true
  replicas: 2

# Sample policies: kyverno/manifests/policies.yaml (apply after Kyverno is Ready).
