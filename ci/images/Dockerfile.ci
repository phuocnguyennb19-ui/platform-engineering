# ============================================================
# CI image — repo-level checks and supply-chain tooling.
#
# Used by (.gitlab-ci.yml):
#   security:gitleaks       secret detection over the full history
#   security:sops-encrypted guard: secrets/* must be SOPS-encrypted
#   security:hadolint       Dockerfile lint
#   chart:scan              trivy config scan + CycloneDX SBOM
#   chart:publish           cosign keyless signing (Sigstore + GitLab OIDC)
#
# Also serves as the default image for Go microservice pipelines
# (ci/deploy-template.gitlab-ci.yml): test:unit, scan:lint, build.
# ============================================================

ARG GO_VERSION=1.25.3
ARG ALPINE_VERSION=3.22
ARG GOLANGCI_LINT_VERSION=2.12.2
ARG GITLEAKS_VERSION=8.30.1
ARG HADOLINT_VERSION=2.15.0
ARG TRIVY_VERSION=0.72.0
ARG COSIGN_VERSION=3.1.2
ARG HELM_VERSION=3.20.1

# ── Stage 1: Download tools ──────────────────────────────────
FROM alpine:${ALPINE_VERSION} AS tools

ARG GOLANGCI_LINT_VERSION
ARG GITLEAKS_VERSION
ARG HADOLINT_VERSION
ARG TRIVY_VERSION
ARG COSIGN_VERSION
ARG HELM_VERSION
# Multi-arch: the previous image hardcoded amd64/x86_64 and produced binaries
# that could not execute on an arm64 runner.
ARG TARGETARCH

# Every vendor spells the architecture differently — these mappings are
# verified against the actual release assets:
#   golangci-lint / cosign / helm  amd64 | arm64
#   hadolint                       x86_64 | arm64
#   gitleaks                       x64    | arm64
#   trivy                          64bit  | ARM64
RUN set -eux; \
    apk add --no-cache curl tar; \
    case "${TARGETARCH:-amd64}" in \
      amd64) GOARCH=amd64; XARCH=x86_64; GLARCH=x64;   TVARCH=64bit ;; \
      arm64) GOARCH=arm64; XARCH=arm64;  GLARCH=arm64; TVARCH=ARM64 ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    \
    # golangci-lint
    curl -fsSL "https://github.com/golangci/golangci-lint/releases/download/v${GOLANGCI_LINT_VERSION}/golangci-lint-${GOLANGCI_LINT_VERSION}-linux-${GOARCH}.tar.gz" \
      | tar xz -C /usr/local/bin --strip-components=1 \
          "golangci-lint-${GOLANGCI_LINT_VERSION}-linux-${GOARCH}/golangci-lint"; \
    \
    # gitleaks
    curl -fsSL "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_${GLARCH}.tar.gz" \
      | tar xz -C /usr/local/bin gitleaks; \
    \
    # hadolint
    curl -fsSL "https://github.com/hadolint/hadolint/releases/download/v${HADOLINT_VERSION}/hadolint-Linux-${XARCH}" \
      -o /usr/local/bin/hadolint; \
    chmod +x /usr/local/bin/hadolint; \
    \
    # trivy — vulnerability + IaC/config scanning, CycloneDX SBOM output
    curl -fsSL "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-${TVARCH}.tar.gz" \
      | tar xz -C /usr/local/bin trivy; \
    \
    # cosign — keyless signing so the kyverno verify-image-signatures policy
    # (security/kyverno/policies-supplychain.yaml) can eventually go Enforce
    curl -fsSL "https://github.com/sigstore/cosign/releases/download/v${COSIGN_VERSION}/cosign-linux-${GOARCH}" \
      -o /usr/local/bin/cosign; \
    chmod +x /usr/local/bin/cosign; \
    \
    # helm — chart:scan renders the chart before running trivy config
    curl -fsSL "https://get.helm.sh/helm-v${HELM_VERSION}-linux-${GOARCH}.tar.gz" \
      | tar xz -C /usr/local/bin --strip-components=1 "linux-${GOARCH}/helm"

# ── Stage 2: Final CI image ──────────────────────────────────
FROM golang:${GO_VERSION}-alpine${ALPINE_VERSION}

# Build essentials
RUN apk add --no-cache \
    git \
    make \
    bash \
    curl \
    jq \
    ca-certificates \
    openssh-client \
    # CGO dependencies (nếu service dùng CGO)
    gcc \
    musl-dev

# Copy tools từ stage 1
COPY --from=tools /usr/local/bin/golangci-lint /usr/local/bin/
COPY --from=tools /usr/local/bin/gitleaks      /usr/local/bin/
COPY --from=tools /usr/local/bin/hadolint      /usr/local/bin/
COPY --from=tools /usr/local/bin/trivy         /usr/local/bin/
COPY --from=tools /usr/local/bin/cosign        /usr/local/bin/
COPY --from=tools /usr/local/bin/helm          /usr/local/bin/

# Go module cache — giúp CI cache modules giữa các job
ENV GOPATH=/go
ENV GOCACHE=/go/cache
ENV GOMODCACHE=/go/pkg/mod
ENV CGO_ENABLED=0
ENV GOOS=linux

# Sanity checks
RUN go version \
    && golangci-lint version \
    && gitleaks version \
    && hadolint --version \
    && trivy --version \
    && cosign version \
    && helm version --short

# Non-root user cho security
RUN addgroup -S ci && adduser -S ci -G ci
USER ci

WORKDIR /workspace
