# prod: only the values that differ per environment — layered after ../values.yaml.gotmpl

# deploymentMode: monolithic collapses all targets into one Deployment for
# non-prod; distributed splits ingester/querier/etc. for prod scale.
deploymentMode: distributed

# ── Gateway (Prometheus remote_write + Grafana read target) ──
# nginx front-door: http://mimir-gateway.observability.svc/api/v1/push
gateway:
  replicas: 2

# Rollout smoothing for stateful components on upgrade.
rollout_operator:
  enabled: true

# ── Monolithic (dev/staging) ────────────────────────────────

# ── Distributed (prod) — per-component sizing ───────────────
ingester:
  replicas: 3
  zoneAwareReplication:
    enabled: true
  persistentVolume:
    size: 50Gi
    {{- if (.Values.storageClass) }}
    storageClass: {{ (.Values.storageClass) }}
    {{- end }}
  resources:
    requests: { cpu: 500m, memory: 2Gi }
    limits:   { cpu: 2, memory: 4Gi }
store_gateway:
  replicas: 3
  zoneAwareReplication:
    enabled: true
  persistentVolume:
    size: 50Gi
    {{- if (.Values.storageClass) }}
    storageClass: {{ (.Values.storageClass) }}
    {{- end }}
distributor:
  replicas: 2
querier:
  replicas: 2
query_frontend:
  replicas: 2
compactor:
  replicas: 1
  persistentVolume:
    size: 50Gi
    {{- if (.Values.storageClass) }}
    storageClass: {{ (.Values.storageClass) }}
    {{- end }}
