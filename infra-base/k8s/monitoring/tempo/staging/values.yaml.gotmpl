# staging: only the values that differ per environment — layered after ../values.yaml.gotmpl

tempo:
  retention: 168h

  resources:
    requests: { cpu: 200m, memory: 512Mi }
    limits:   { cpu: 1, memory: 1Gi }

  storage:
    trace:
      backend: local
      local:
        path: /var/tempo/traces

# Prometheus must accept remote_write from the metrics-generator.
# (kube-prometheus-stack sets enableRemoteWriteReceiver — see note in README.)

persistence:
  size: 20Gi
