# ============================================================
# Apache Kafka — event streaming / async backbone (KRaft, no ZooKeeper)
# Chart: bitnami/kafka · ns `database`
#
# Topology (KRaft combined controller+broker for non-prod; split for prod):
#   dev/staging → 1 controller-eligible broker (no HA)
#   prod        → 3 brokers + 3 controllers, RF=3, min.insync.replicas=2
#
# ⚠ Bitnami image caveat — mirror via Harbor in prod (see postgresql/README).
#
# Secrets (SOPS → .Values.secrets.kafka.*):
#   clientPassword     → SASL/SCRAM app user
#   interBrokerPassword, controllerPassword → internal auth (prod)
#
# What lives where:
#   values.yaml.gotmpl → topology, listeners/SASL, sizing, metrics
#   Secret (SOPS)      → SASL passwords (existingSecret)
#   files/            → server.properties extras via `extraConfig`
#
# For large-scale prod, graduate to the Strimzi operator (see README).
# ============================================================

fullnameOverride: kafka

global:
  imageRegistry: {{ printf "%s.dkr.ecr.%s.amazonaws.com" (requiredEnv "AWS_ACCOUNT_ID") (env "AWS_REGION" | default "ap-southeast-1") | quote }}   # ECR mirror, filled by images:mirror
  security:
    # The chart rejects any registry but docker.io; the mirror holds the same
    # bitnamilegacy images, copied by digest. This disables only that origin check.
    allowInsecureImages: true

# KRaft mode (no ZooKeeper).
kraft:
  enabled: true

listeners:
  client:
    protocol: SASL_PLAINTEXT           # SASL_SSL once cert-manager certs are wired (README)
  interbroker:
    protocol: SASL_PLAINTEXT
  controller:
    protocol: SASL_PLAINTEXT

sasl:
  enabledMechanisms: SCRAM-SHA-256,PLAIN
  existingSecret: kafka
  # keys the chart reads from the existingSecret:
  client:
    users: [ appuser ]

extraDeploy:
  - apiVersion: v1
    kind: Secret
    metadata:
      name: kafka
      namespace: database
    type: Opaque
    stringData:
      client-passwords:       {{ .Values.secrets.kafka.clientPassword       | quote }}
      inter-broker-password:  {{ .Values.secrets.kafka.interBrokerPassword  | quote }}
      controller-password:    {{ .Values.secrets.kafka.controllerPassword   | quote }}

# ── Controllers ─────────────────────────────────────────────
# ── Controllers ─────────────────────────────────────────────
controller:
  persistence:
    enabled: true
    size: 10Gi
    {{- if (.Values.storageClass) }}
    storageClass: {{ (.Values.storageClass) }}
    {{- end }}
  pdb:
    maxUnavailable: 1
    create: false
  replicaCount: 1
  controllerOnly: false        # prod: dedicated controllers; non-prod: combined
  resources:
    requests: { cpu: 250m, memory: 512Mi }
    limits:   { cpu: 1, memory: 1Gi }
  podAntiAffinityPreset: soft

# ── Hardening ───────────────────────────────────────────────
containerSecurityContext:
  enabled: true
  runAsUser: 1001
  runAsNonRoot: true
  allowPrivilegeEscalation: false
  seccompProfile: { type: RuntimeDefault }
  capabilities: { drop: [ ALL ] }
podSecurityContext:
  enabled: true
  fsGroup: 1001

metrics:
  kafka:
    enabled: true
  jmx:
    enabled: true
  serviceMonitor:
    enabled: true
    labels:
      release: kube-prometheus-stack

networkPolicy:
  allowExternal: false
  enabled: false
# ── Broker config: mounted as ConfigMap from files/server.properties ──
# Static tunables come from the file (readFile); env-sized durability knobs
# (replication factors / ISR / retention) are appended from the $size table.
extraConfig: |
{{ readFile "files/server.properties" | indent 2 }}
  # ── env-sized durability (from $size) ──
  offsets.topic.replication.factor=1
  transaction.state.log.replication.factor=1
  transaction.state.log.min.isr=1
  default.replication.factor=1
  min.insync.replicas=1
  log.retention.hours=72

# ── Brokers (prod only — non-prod uses combined controllers) ─
broker:
  replicaCount: 0                      # combined mode: controllers serve as brokers
