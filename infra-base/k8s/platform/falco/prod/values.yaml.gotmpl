# prod: only the values that differ per environment — layered after ../values.yaml.gotmpl

# ── Falco engine outputs ────────────────────────────────────
falco:
  log_level: warning
  priority: notice

# ── Falcosidekick — routing to Alertmanager + Loki ──────────
falcosidekick:
  replicaCount: 2
  webui:
    enabled: true
