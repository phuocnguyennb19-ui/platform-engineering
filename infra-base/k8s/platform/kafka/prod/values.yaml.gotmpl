# prod: only the values that differ per environment — layered after ../values.yaml.gotmpl

# ── Broker config: mounted as ConfigMap from files/server.properties ──
# Static tunables come from the file (readFile); env-sized durability knobs
# (replication factors / ISR / retention) are appended from the $size table.
extraConfig: |
{{ readFile "../files/server.properties" | indent 2 }}
  # ── env-sized durability (from $size) ──
  offsets.topic.replication.factor=3
  transaction.state.log.replication.factor=3
  transaction.state.log.min.isr=2
  default.replication.factor=3
  min.insync.replicas=2
  log.retention.hours=168

# ── Controllers ─────────────────────────────────────────────
controller:
  replicaCount: 3
  controllerOnly: true        # prod: dedicated controllers; non-prod: combined
  persistence:
    size: 100Gi
    {{- if (.Values.storageClass) }}
    storageClass: {{ (.Values.storageClass) }}
    {{- end }}
  resources:
    requests: { cpu: 1, memory: 2Gi }
    limits:   { cpu: 2, memory: 4Gi }
  podAntiAffinityPreset: hard
  pdb:
    create: true

# ── Brokers (prod only — non-prod uses combined controllers) ─
broker:
  replicaCount: 3
  persistence:
    enabled: true
    size: 100Gi
    {{- if (.Values.storageClass) }}
    storageClass: {{ (.Values.storageClass) }}
    {{- end }}
  resources:
    requests: { cpu: 1, memory: 2Gi }
    limits:   { cpu: 2, memory: 4Gi }
  podAntiAffinityPreset: hard
  pdb:
    create: true
    maxUnavailable: 1

networkPolicy:
  enabled: true
