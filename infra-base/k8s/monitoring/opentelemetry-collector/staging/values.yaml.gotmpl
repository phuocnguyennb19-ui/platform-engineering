# staging: only the values that differ per environment — layered after ../values.yaml.gotmpl

replicaCount: 2

resources:
  requests: { cpu: 200m, memory: 512Mi }
  limits:   { cpu: 1, memory: 1Gi }

config:

  processors:
    # Guardrail against OOM under load — spill/refuse above the soft limit.
    memory_limiter:
      limit_mib: 900
      spike_limit_mib: 225
