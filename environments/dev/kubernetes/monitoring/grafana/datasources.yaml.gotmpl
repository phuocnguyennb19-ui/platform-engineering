# ============================================================
# Grafana — Datasources (provisioned)
# Merged into the `grafana` release on top of values.yaml.gotmpl.
# Kept in a dedicated file so datasource wiring evolves independently
# of the core Grafana runtime config.
#
# Correlation Metrics ↔ Logs ↔ Traces:
#   Prometheus (metrics) — default
#   Loki       (logs)    — derivedFields → Tempo
#   Tempo      (traces)  — tracesToLogs (Loki) + tracesToMetrics (Prometheus)
#   OpenSearch (search)  — needs the plugin + secret mount declared below
#
# UIDs are fixed (prometheus/loki/tempo/opensearch) so cross-datasource
# links resolve deterministically across environments.
# ============================================================

datasources:
  datasources.yaml:
    apiVersion: 1
    datasources:
      - name: Prometheus
        type: prometheus
        uid: prometheus
        access: proxy
        url: http://kube-prometheus-stack-prometheus.{{ (.Values.namespace     | default "observability") }}.svc.{{ (.Values.clusterDomain | default "cluster.local") }}:9090
        isDefault: true
      - name: Loki
        type: loki
        uid: loki
        access: proxy
        url: http://loki-gateway.{{ (.Values.namespace     | default "observability") }}.svc.{{ (.Values.clusterDomain | default "cluster.local") }}
        jsonData:
          maxLines: 1000
          derivedFields:
            - name: TraceID
              matcherRegex: '"trace_id":"(\w+)"'
              url: '$${__value.raw}'
              datasourceUid: tempo
      - name: Tempo
        type: tempo
        uid: tempo
        access: proxy
        url: http://tempo.{{ (.Values.namespace     | default "observability") }}.svc.{{ (.Values.clusterDomain | default "cluster.local") }}:3100
        jsonData:
          tracesToLogsV2:
            datasourceUid: loki
            filterByTraceID: true
          tracesToMetrics:
            datasourceUid: prometheus
          serviceMap:
            datasourceUid: prometheus
          nodeGraph:
            enabled: true
      - name: OpenSearch
        type: grafana-opensearch-datasource
        uid: opensearch
        access: proxy
        url: https://opensearch-cluster-master.{{ (.Values.namespace     | default "observability") }}.svc.{{ (.Values.clusterDomain | default "cluster.local") }}:9200
        basicAuth: true
        basicAuthUser: admin
        secureJsonData:
          # Mapped from SOPS env secret; chart stores it in the datasources Secret.
          basicAuthPassword: {{ .Values.secrets.opensearch.password | quote }}
        jsonData:
          tlsSkipVerify: true   # dev: demo cert · staging/prod: real CA
          flavor: opensearch
          database: "logs-*"
          timeField: "@timestamp"
          version: "2.11.0"

# ── Support for the OpenSearch datasource ───────────────────
# Plugin required by the datasource type above. The password is mapped inline
# from .Values.secrets.opensearch.password (SOPS) — no secret mount needed.
plugins:
  - grafana-opensearch-datasource
