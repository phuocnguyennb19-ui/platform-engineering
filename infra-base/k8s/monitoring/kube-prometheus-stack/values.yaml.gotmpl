# ============================================================
# kube-prometheus-stack — CORE (CRDs, Operator, exporters)
# Chart: prometheus-community/kube-prometheus-stack
#
# Split into focused files, all merged by the release:
#   values.yaml.gotmpl        ← this: CRDs, Operator, exporters, grafana off
#   prometheus.yaml.gotmpl    ← Prometheus server (sizing/retention/storage)
#   alertmanager.yaml.gotmpl  ← Alertmanager (sizing/storage/routing)
#
# Grafana is a STANDALONE release (release/grafana/*) — disabled here but
# dashboards still emitted for its sidecar to pick up.
# ============================================================

fullnameOverride: kube-prometheus-stack

# Operator CRDs (ServiceMonitor/PodMonitor/PrometheusRule) — required by
# every other observability release.
crds:
  enabled: true

# ============================================================
# Prometheus Operator
# ============================================================
prometheusOperator:
  resources:
    requests: { cpu: 100m, memory: 128Mi }
    limits:   { cpu: 300m, memory: 512Mi }

# ============================================================
# Grafana — standalone release (release/grafana/*)
# ============================================================
grafana:
  # Disable the subchart, but still publish dashboard ConfigMaps (label
  # grafana_dashboard) so the standalone Grafana's sidecar loads them.
  enabled: false
  forceDeployDashboards: true

# ============================================================
# Cluster-level exporters
# ============================================================
nodeExporter:
  enabled: true
kube-state-metrics:
  enabled: true
