# ============================================================
# ingress-nginx — LEGACY IngressClass nginx-<env>, being retired in favour of Kong
# (IngressClass `kong`). Installed while state.yaml ingressNginx: true.
#
# Self-contained helmfile state. Deploy this tool alone:
#   helmfile -e dev --kube-context <ctx> -f kubernetes/releases/platform/ingress-nginx/helmfile.yaml.gotmpl sync   # from the repo root
#
# ⚠ Each folder is a SEPARATE state, so `needs` cannot reference a release in
#   another folder. Deploy ORDER lives in the root helmfile.yaml.gotmpl include
#   list — that list is load-bearing, this file must not encode cross-tool order.
# ============================================================
bases:
  - ../../../repositories.yaml
environments:
  dev:     { values: [ ../../../../environments/dev/kubernetes/state.yaml ], secrets: [ ../../../../environments/dev/kubernetes/secrets.enc.yaml ] }
  staging: { values: [ ../../../../environments/staging/kubernetes/state.yaml ], secrets: [ ../../../../environments/staging/kubernetes/secrets.enc.yaml ] }
  prod:    { values: [ ../../../../environments/prod/kubernetes/state.yaml ], secrets: [ ../../../../environments/prod/kubernetes/secrets.enc.yaml ] }

---
{{- $env := .Environment.Name }}

releases:
  - name: ingress-nginx
    namespace: infra
    chart: ingress-nginx/ingress-nginx
    version: 4.15.1
    # Being retired: Kong is the only ingress controller. ingressNginx in
    # environments/<env>/kubernetes/state.yaml (default true) — false UNINSTALLS this
    # release (NLB deleted). Cutover order: ../kong/README.md §8.
    installed: {{ .Values | get "ingressNginx" true }}
    missingFileHandler: Error
    labels: { name: ingress-nginx, layer: platform, tier: infra, component: ingress, env: "{{ $env }}" }
    values:
      - ../../../../environments/{{ .Environment.Name }}/kubernetes/ingress/ingress-nginx/values.yaml.gotmpl
