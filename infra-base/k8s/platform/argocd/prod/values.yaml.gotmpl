# prod: only the values that differ per environment — layered after ../values.yaml.gotmpl

configs:
  cm:
    # ── Local admin account ──────────────────────────────────────────────
    # Enabled in dev/staging for convenience. DISABLED in prod: the built-in
    # admin is a shared, non-attributable, non-revocable credential with full
    # cluster-admin reach through Argo, and it bypasses the SSO audit trail.
    #
    # ⚠ Configure SSO (dex.config / oidc.config) BEFORE the first prod sync —
    #   with admin disabled and no SSO configured, nobody can log in. Recover
    #   by flipping this back to "true" and restarting argocd-server.
    admin.enabled: "false"
  # Registers this cluster under its environment. The platform-apps ApplicationSet
  # generates Applications only for the environment of the cluster it runs in,
  # so one cluster never deploys another environment's apps.
  clusterCredentials:
    in-cluster:
      labels:
        platform.example.com/environment: "prod"
        platform.example.com/auto-sync: "false"
  # ── RBAC ─────────────────────────────────────────────────────────────
  # Default role for any authenticated identity that matches no policy.
  # `readonly`, not `admin` — an SSO user with no group mapping gets look-only.
  rbac:
    policy.default: role:readonly
    policy.csv: |
      # Map your IdP groups here, e.g.:
      # g, platform-team@example.com, role:admin
      # g, devs@example.com,          role:readonly
    scopes: "[groups, email]"

repoServer:
  replicas: 2
  autoscaling:
    enabled: true
    minReplicas: 2
    maxReplicas: 5

server:
  replicas: 2
  ingress:
    ingressClassName: nginx-prod
    annotations:
      cert-manager.io/cluster-issuer: letsencrypt-prod

applicationSet:
  replicas: 2
redis:
  enabled: false

# Prod: Redis HA (3 nodes + sentinel). Dev/staging: standalone redis.
redis-ha:
  enabled: true
