# staging: only the values that differ per environment — layered after ../config.yaml.gotmpl

loki:

  commonConfig:
    replication_factor: 1

  schemaConfig:
    configs:
      - from: "2024-04-01"
        store: tsdb
        object_store: filesystem
        schema: v13
        index:
          prefix: loki_index_
          period: 24h

  limits_config:
    retention_period: 168h

  compactor:
    delete_request_store: filesystem
  # dev / staging — local filesystem (no cloud).
  storage:
    type: filesystem
