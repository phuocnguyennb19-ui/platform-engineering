# dev: only the values that differ per environment — layered after ../values.yaml.gotmpl

architecture: standalone

master:
  persistence:
    size: 5Gi
    {{- if (.Values.storageClass) }}
    storageClass: {{ (.Values.storageClass) }}
    {{- end }}
  resources:
    requests: { cpu: 50m, memory: 128Mi }
    limits:   { cpu: 250m, memory: 256Mi }
  pdb:
    create: false

networkPolicy:
  enabled: false
