# ============================================================
# PostgreSQL — primary relational store (shared platform DB)
# Chart: bitnami/postgresql · ns `database`
#
# Topology:
#   dev/staging → architecture=standalone (1 primary)
#   prod        → architecture=replication (1 primary + N sync replicas)
#
# ⚠ Bitnami image caveat (2025+): docker.io/bitnami keeps only `latest`.
#   Pin via a mirror: set global.imageRegistry to your Harbor proxy-cache
#   (harbor.<domain>, project `bitnami`). Placeholder below defaults to
#   docker.io — override in prod. See README.md.
#
# Secrets (SOPS → .Values.secrets.postgresql.*):
#   postgresPassword  → superuser
#   password          → app user (username below)
#   replicationPassword → streaming replication user (prod)
#
# What lives where:
#   values.yaml.gotmpl → topology, sizing, HA, backups, metrics
#   Secret (SOPS)      → all passwords (never in values)
#   files/            → postgresql.conf tunables via primary.configuration
#
# For large-scale prod, graduate to the CloudNativePG operator (see README).
# ============================================================

fullnameOverride: postgresql

# Bitnami images come from this environment's ECR mirror (bitnami/<image>),
# filled by the images:mirror job — docker.io/bitnami no longer serves pinned tags.
global:
  imageRegistry: {{ printf "%s.dkr.ecr.%s.amazonaws.com" (requiredEnv "AWS_ACCOUNT_ID") (env "AWS_REGION" | default "ap-southeast-1") | quote }}
  security:
    # The chart rejects any registry but docker.io; the mirror holds the same
    # bitnamilegacy images, copied by digest. This disables only that origin check.
    allowInsecureImages: true
  postgresql:
    auth:
      username: appuser
      database: appdb
      # Passwords come from the SOPS-provisioned existing secret below.
      existingSecret: postgresql
      secretKeys:
        adminPasswordKey: postgres-password
        userPasswordKey: password
        replicationPasswordKey: replication-password

# ── The secret consumed via existingSecret above (rendered from SOPS) ──
# Rendered as an extra manifest so passwords never appear in plain values.
extraDeploy:
  - apiVersion: v1
    kind: Secret
    metadata:
      name: postgresql
      namespace: database
      labels:
        app.kubernetes.io/managed-by: helmfile
    type: Opaque
    stringData:
      postgres-password:    {{ .Values.secrets.postgresql.postgresPassword    | quote }}
      password:             {{ .Values.secrets.postgresql.password             | quote }}
      replication-password: {{ .Values.secrets.postgresql.replicationPassword  | quote }}

# ── Primary ─────────────────────────────────────────────────
primary:
  persistence:
    enabled: true
  pgHbaConfiguration: |
{{ readFile "files/pg_hba.conf" | indent 4 }}
  pdb:
    maxUnavailable: 1

# ── Read replicas (prod, streaming replication) ─────────────

# ── Hardening (rootless, restricted PSA) ────────────────────
primary.podSecurityContext:
  enabled: true
  fsGroup: 1001
containerSecurityContext:
  enabled: true
  runAsUser: 1001
  runAsNonRoot: true
  allowPrivilegeEscalation: false
  seccompProfile: { type: RuntimeDefault }
  capabilities: { drop: [ ALL ] }

# ── Backups: rely on Velero PV snapshots + logical dump CronJob (README) ──
# Point-in-time base backups to MinIO/S3 recommended via pgBackRest sidecar
# (out of scope of this chart) — documented in README.md.

# ── Metrics ─────────────────────────────────────────────────
metrics:
  enabled: true
  serviceMonitor:
    enabled: true
    labels:
      release: kube-prometheus-stack
  # Shipped exporter rules; wire PrometheusRule via kube-prometheus-stack.
