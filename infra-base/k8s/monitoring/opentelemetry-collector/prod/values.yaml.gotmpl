# prod: only the values that differ per environment — layered after ../values.yaml.gotmpl

replicaCount: 2

resources:
  requests: { cpu: 500m, memory: 1Gi }
  limits:   { cpu: 2, memory: 2Gi }

config:

  processors:
    # Guardrail against OOM under load — spill/refuse above the soft limit.
    memory_limiter:
      limit_mib: 1800
      spike_limit_mib: 450
autoscaling:
  enabled: true
  minReplicas: 2
  maxReplicas: 6
  targetCPUUtilizationPercentage: 70
  targetMemoryUtilizationPercentage: 75
podDisruptionBudget:
  enabled: true
  minAvailable: 1
