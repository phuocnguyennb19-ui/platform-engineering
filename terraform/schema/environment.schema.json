{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "infra-base/terraform/environments/<env>/environment.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["environment", "account", "region", "name_prefix", "release"],
  "properties": {
    "environment": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^([0-9]{12})?$" }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z]{2}(-gov)?-[a-z]+-[0-9]$" }
      }
    },
    "name_prefix": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,19}$" },
    "tags": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_tag_source"],
      "properties": {
        "image_tag_source": { "enum": ["pipeline", "config"] },
        "promote_from": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" }
      }
    }
  }
}
