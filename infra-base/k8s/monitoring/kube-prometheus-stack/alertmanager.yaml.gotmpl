# ============================================================
# kube-prometheus-stack — Alertmanager
# Merged into the release on top of values.yaml.gotmpl.
# Sizing/storage per env; severity-based routing + inhibition below.
# ============================================================

alertmanager:
  alertmanagerSpec:
    logLevel: info
    # Cluster gossip is auto-configured by the operator across replicas.
    resources:
      requests: { cpu: 50m, memory: 128Mi }
      limits:   { cpu: 200m, memory: 256Mi }
    storage:
      volumeClaimTemplate:
        spec:
          {{- if (.Values.storageClass) }}
          storageClassName: {{ (.Values.storageClass) }}
          {{- end }}
          accessModes: ["ReadWriteOnce"]
    securityContext:
      runAsNonRoot: true
      runAsUser: 1000
      fsGroup: 2000
    # Notifier credentials (Slack URL / PagerDuty key) mounted from a secret
    # created out-of-band; referenced by *_file options in receivers below.
    # secrets:
    #   - alertmanager-notifiers

  # ── Routing + notifications ─────────────────────────────────
  config:
    global:
      resolve_timeout: 5m
    route:
      group_by: ['namespace', 'alertname']
      group_wait: 30s
      group_interval: 5m
      repeat_interval: 4h
      receiver: 'null'
      routes:
        # Dead-man's switch — never notify.
        - matchers: [ 'alertname = "Watchdog"' ]
          receiver: 'null'
        # Page immediately on critical; also fan out (continue) to warning.
        - matchers: [ 'severity = "critical"' ]
          receiver: 'critical'
          group_wait: 10s
          repeat_interval: 1h
          continue: true
        - matchers: [ 'severity = "warning"' ]
          receiver: 'warning'
    receivers:
      - name: 'null'
      - name: 'critical'
        # pagerduty_configs:
        #   - routing_key_file: /etc/alertmanager/secrets/alertmanager-notifiers/pagerduty-key
        #     send_resolved: true
      - name: 'warning'
        # slack_configs:
        #   - api_url_file: /etc/alertmanager/secrets/alertmanager-notifiers/slack-url
        #     channel: '#alerts-dev'
        #     send_resolved: true
        #     title: '{{`{{ .CommonAnnotations.summary }}`}}'
    # Suppress warnings when a critical for the same alert/namespace is firing.
    inhibit_rules:
      - source_matchers: [ 'severity = "critical"' ]
        target_matchers: [ 'severity = "warning"' ]
        equal: [ 'namespace', 'alertname' ]
