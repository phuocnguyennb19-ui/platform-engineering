# ============================================================
# OpenSearch Dashboards — UI for OpenSearch
# Chart: opensearch/opensearch-dashboards
#
# Connects to the cluster at https://opensearch-cluster-master:9200
# Exposed via Ingress at dashboards.<domain> (TLS in staging/prod).
# ============================================================

opensearchHosts: "https://opensearch-cluster-master.{{ (.Values.namespace) }}.svc.{{ (.Values.clusterDomain) }}:9200"

# Dashboards → OpenSearch auth. Credentials come from a SOPS secret,
# never inline.
extraEnvs:
  - name: OPENSEARCH_USERNAME
    value: admin
  - name: OPENSEARCH_PASSWORD
    valueFrom:
      secretKeyRef:
        name: opensearch-admin
        key: password

securityContext:
  runAsNonRoot: true
  runAsUser: 1000
podSecurityContext:
  fsGroup: 1000

ingress:
  enabled: true
  ingressClassName: {{ .Values.ingressClass }}
  hosts:
    - host: dashboards.{{ .Values.ingressDomain }}
      paths:
        - path: /
          # Empty backend → chart defaults to this release's service + port.
          backend:
            serviceName: ""
            servicePort: ""
