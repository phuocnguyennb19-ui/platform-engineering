# ============================================================
# Kong Gateway — API gateway + Gateway API controller (DB-less)
# Chart: kong/kong · ns `infra`
#
# Role: THE ingress controller of the cluster (ingress-nginx is being retired —
# state.yaml ingressNginx, cutover in kubernetes/releases/platform/kong/README.md §8).
# Every platform UI and every app uses classic Ingress with ingressClassName `kong`
# (state.yaml ingressClass); Gateway API (GatewayClass `kong`) is also implemented.
# Gateway features (auth, rate-limit, transformations, mTLS) come from plugins.
#
# DB-less + declarative: no PostgreSQL dependency; config comes from CRDs
# (KongPlugin, KongConsumer, HTTPRoute) reconciled by the built-in controller.
# This keeps Kong stateless and GitOps-friendly.
#
# What lives where:
#   values.yaml.gotmpl  → proxy/controller, Gateway API, TLS, sizing
#   manifests/plugins.yaml → declarative plugins as KongClusterPlugin CRs, rendered into
#                         this release (chart extraObjects) by
#                         kubernetes/releases/platform/kong/extra-objects.yaml.gotmpl —
#                         one sync installs Kong and its plugins together.
#   Secret (SOPS)       → plugin credentials (JWT/keys) referenced by CRs
# ============================================================

fullnameOverride: kong

# ── Controller (ingress + Gateway API reconciler) ───────────
ingressController:
  enabled: true
  ingressClass: kong
  gatewayDiscovery:
    enabled: false
  env:
    # Gateway API v1 (Gateway/HTTPRoute) needs no gate in KIC 3.x. GatewayAlpha adds the
    # alpha route kinds (TCPRoute/UDPRoute/TLSRoute), which need the EXPERIMENTAL-channel
    # CRDs; gateway-api installs the standard channel, so today this gate has nothing to
    # watch. Kept so those kinds work if the experimental CRDs are ever installed.
    feature_gates: "GatewayAlpha=true"
    publish_service: infra/kong-proxy

# ── DB-less ─────────────────────────────────────────────────
# ── DB-less ─────────────────────────────────────────────────
env:
  database: "off"
  router_flavor: expressions
  log_level: info

# ── Proxy (data plane) ──────────────────────────────────────
# ── Proxy (data plane) ──────────────────────────────────────
proxy:
  tls:
    enabled: true
  # AWS NLB (in-tree service controller) — the LB type ingress-nginx has; TLS terminates in
  #   Kong. dev was NodePort before, so this is a NEW internet-facing LB (in-tree default
  #   scheme). Changing the LB type later recreates it with a new address.
  # ⚠ helmDefaults sets `wait: true`: a LoadBalancer Service blocks the release until it gets
  #   an address. Every dev target here has an LB provider (EKS, Docker Desktop, K3s servicelb);
  #   on kind/minikube use `minikube tunnel` / metallb, or override type: NodePort locally.
  type: LoadBalancer
  http:
    enabled: true              # every env: ACME HTTP-01 + http→https redirect need port 80
  annotations:
    service.beta.kubernetes.io/aws-load-balancer-type: nlb

autoscaling:
  targetCPUUtilizationPercentage: 70
  enabled: false
  minReplicas: 1
  maxReplicas: 3

podDisruptionBudget:
  minAvailable: 1
  enabled: false

affinity:
  podAntiAffinity:
    preferredDuringSchedulingIgnoredDuringExecution:
      - weight: 100
        podAffinityTerm:
          topologyKey: kubernetes.io/hostname
          labelSelector:
            matchLabels:
              app.kubernetes.io/name: kong

# ── Hardening ───────────────────────────────────────────────
containerSecurityContext:
  runAsNonRoot: true
  runAsUser: 1000
  allowPrivilegeEscalation: false
  readOnlyRootFilesystem: true
  seccompProfile: { type: RuntimeDefault }
  capabilities: { drop: [ ALL ] }

# ── Admin API stays cluster-internal (no public control plane) ──
admin:
  enabled: true
  type: ClusterIP
  http:
    enabled: false
  tls:
    enabled: true

manager:
  enabled: false                       # Kong Manager UI off (use CRDs/git)

# ── Metrics (Prometheus plugin exposes /metrics) ────────────
serviceMonitor:
  enabled: true
  labels:
    release: kube-prometheus-stack

replicaCount: 1
resources:
  requests: { cpu: 100m, memory: 256Mi }
  limits:   { cpu: 500m, memory: 512Mi }
