{{/*
===============================================================================
PROXY SIDECAR — opt-in nginx reverse proxy in front of the app container.

  Ingress / HTTPRoute → Service :service.port → targetPort `http`
    → nginx (proxy.port, port name `http`) → proxy_pass http://127.0.0.1:proxy.upstreamPort
    → app container (proxy.upstreamPort, port name `app`)

App workload only (Deployment / StatefulSet / DaemonSet). Workers and cronjobs never
get it: `proxy` is not in componentConfig's inherited list and podSpec only renders it
when the caller passes "proxy" true (templates/app/workload.yaml).

Every helper here is reached only when proxy.enabled is true, so a values file that
leaves proxy off renders byte-identically to 2.2.0.
===============================================================================
*/}}

{{- define "application.proxy.enabled" -}}
{{- if (.Values.proxy).enabled }}true{{ end -}}
{{- end }}

{{- define "application.proxy.configmapName" -}}
{{- printf "%s-proxy" (include "application.fullname" .) | trunc 63 | trimSuffix "-" -}}
{{- end }}

{{- /* Mount points inside the nginx container. /tmp holds the pid file and every
       *_temp_path, so readOnlyRootFilesystem: true works; /var/cache/nginx is the
       compiled-in temp root of the nginx images and is mounted as well so a
       `proxy.config` override that keeps the image defaults still starts. */ -}}
{{- define "application.proxy.confDir" -}}/etc/nginx/proxy{{- end }}

{{/*
nginx.conf — `proxy.config` replaces the whole file (passes through tpl); otherwise
the file below is generated from the proxy.* knobs. An override must keep
`pid /tmp/nginx.pid;` (preStop waits on it) and listen on proxy.port.
*/}}
{{- define "application.proxy.nginxConf" -}}
{{- $p := .Values.proxy -}}
{{- if $p.config -}}
{{ tpl (toString $p.config) . }}
{{- else -}}
# Generated by charts/application (proxy.*). Replace the whole file with proxy.config.
worker_processes {{ $p.workerProcesses }};
pid /tmp/nginx.pid;
error_log /dev/stderr {{ $p.errorLogLevel }};

events {
  worker_connections {{ $p.workerConnections }};
}

http {
  server_tokens off;
  default_type application/octet-stream;

  # readOnlyRootFilesystem: every writable path lives on the /tmp emptyDir.
  client_body_temp_path /tmp/client_temp;
  proxy_temp_path       /tmp/proxy_temp;
  fastcgi_temp_path     /tmp/fastcgi_temp;
  uwsgi_temp_path       /tmp/uwsgi_temp;
  scgi_temp_path        /tmp/scgi_temp;

  log_format proxy '$remote_addr - [$time_local] "$request" $status $body_bytes_sent '
                   '"$http_referer" "$http_user_agent" rid=$http_x_request_id '
                   'rt=$request_time urt=$upstream_response_time';
  {{- if $p.accessLog }}
  access_log /dev/stdout proxy;
  {{- else }}
  access_log off;
  {{- end }}
  {{- with $p.realIpFrom }}

  # Trust X-Forwarded-For only from these peers (the ingress controller), so
  # $remote_addr / X-Real-IP is the client, not the controller pod.
  {{- range . }}
  set_real_ip_from {{ . }};
  {{- end }}
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;
  {{- end }}

  # X-Forwarded-Proto from the ingress controller (TLS terminates there); $scheme when absent.
  map $http_x_forwarded_proto $proxy_x_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
  }
  # WebSocket upgrade passes through; plain requests keep the upstream connection alive.
  map $http_upgrade $proxy_connection {
    default upgrade;
    ""      "";
  }

  client_max_body_size {{ $p.clientMaxBodySize }};

  upstream app {
    server 127.0.0.1:{{ $p.upstreamPort }};
    {{- if gt (int $p.upstreamKeepalive.connections) 0 }}
    keepalive {{ $p.upstreamKeepalive.connections }};
    keepalive_timeout {{ $p.upstreamKeepalive.timeout }};
    {{- end }}
  }
  {{- with $p.httpSnippet }}{{ "\n" }}
  {{- tpl (toString .) $ | trim | nindent 2 }}
  {{- end }}

  server {
    listen {{ $p.port }};
    server_name _;

    # Answered by nginx itself, never proxied: the sidecar's own probes.
    location = {{ $p.healthPath }} {
      access_log off;
      default_type text/plain;
      return 200 "ok\n";
    }

    location / {
      proxy_pass http://app;
      proxy_http_version 1.1;
      proxy_set_header Host              $http_host;
      proxy_set_header X-Real-IP         $remote_addr;
      proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
      proxy_set_header X-Request-ID      $http_x_request_id;   # empty = not sent
      proxy_set_header Upgrade           $http_upgrade;
      proxy_set_header Connection        $proxy_connection;
      proxy_connect_timeout {{ $p.timeouts.connect }};
      proxy_send_timeout    {{ $p.timeouts.send }};
      proxy_read_timeout    {{ $p.timeouts.read }};
    }
    {{- with $p.serverSnippet }}{{ "\n" }}
    {{- tpl (toString .) $ | trim | nindent 4 }}
    {{- end }}
  }
}
{{- end }}
{{- end }}

{{- define "application.proxy.checksum" -}}
checksum/proxy-config: {{ include "application.proxy.nginxConf" . | sha256sum }}
{{- end }}

{{/*
The app's probes keep probing the APP, not nginx: `port: http` now names the nginx
port and lives on the other container, where the kubelet cannot resolve it for the
app container. httpGet/tcpSocket `port: http` is rewritten to `app`
(= proxy.upstreamPort). Numeric ports and other names are left alone.
*/}}
{{- define "application.proxy.appProbe" -}}
{{- $p := deepCopy . -}}
{{- range $h := (list "httpGet" "tcpSocket") -}}
  {{- $hd := index $p $h -}}
  {{- if and $hd (kindIs "map" $hd) (eq (toString $hd.port) "http") -}}
    {{- $_ := set $hd "port" "app" -}}
  {{- end -}}
{{- end -}}
{{- toYaml $p -}}
{{- end }}

{{/*
The app container's lifecycle with the proxy on: preStop becomes a native sleep of
proxy.shutdown.appPreStopSleepSeconds so the app outlives nginx's drain + graceful
quit (postStart is kept). 0 = keep `lifecycle` exactly as given.
*/}}
{{- define "application.proxy.appLifecycle" -}}
{{- $root := .root -}}
{{- $lc := deepCopy (.lifecycle | default dict) -}}
{{- $hold := int (($root.Values.proxy.shutdown).appPreStopSleepSeconds | default 0) -}}
{{- if gt $hold 0 -}}
  {{- $_ := set $lc "preStop" (dict "sleep" (dict "seconds" $hold)) -}}
{{- end -}}
{{- with $lc }}{{ toYaml . }}{{ end -}}
{{- end }}

{{- /* The nginx container, a list item at the indentation of `containers:` entries. */ -}}
{{- define "application.proxy.container" -}}
{{- $root := .root -}}
{{- $c := .c -}}
{{- $p := $root.Values.proxy -}}
{{- $confDir := include "application.proxy.confDir" $root -}}
- name: proxy
  image: {{ include "application.image" (dict "root" $root "image" $p.image) }}
  imagePullPolicy: {{ $p.image.pullPolicy | default "IfNotPresent" }}
  {{- /* Bypasses the image entrypoint scripts (they try to rewrite conf.d on a read-only rootfs). */}}
  command: ["nginx", "-c", "{{ $confDir }}/nginx.conf", "-g", "daemon off;"]
  {{- $sec := include "application.containerSecurityContext" (dict "root" $root "c" (dict "securityContext" ($p.securityContext | default dict))) | trim }}
  {{- if $sec }}
  securityContext:
    {{- $sec | nindent 4 }}
  {{- end }}
  ports:
    - name: http
      containerPort: {{ $p.port }}
      protocol: TCP
  readinessProbe:
    httpGet: { path: {{ $p.healthPath | quote }}, port: http }
    periodSeconds: 5
    timeoutSeconds: 2
    failureThreshold: 3
  livenessProbe:
    httpGet: { path: {{ $p.healthPath | quote }}, port: http }
    periodSeconds: 15
    timeoutSeconds: 3
    failureThreshold: 3
  {{- with $p.resources }}
  resources:
    {{- toYaml . | nindent 4 }}
  {{- end }}
  lifecycle:
    preStop:
      exec:
        {{- /* Keep serving while the endpoint is removed from the Service / ingress, then
               quit gracefully (in-flight requests finish) and wait for the master to exit. */}}
        command:
          - /bin/sh
          - -c
          - sleep {{ int $p.shutdown.drainSeconds }}; nginx -c {{ $confDir }}/nginx.conf -s quit; while [ -f /tmp/nginx.pid ]; do sleep 1; done
  volumeMounts:
    - { name: proxy-config, mountPath: {{ $confDir }}, readOnly: true }
    - { name: proxy-tmp, mountPath: /tmp }
    - { name: proxy-cache, mountPath: /var/cache/nginx }
{{- end }}

{{- define "application.proxy.volumes" -}}
{{- $p := .Values.proxy -}}
- name: proxy-config
  configMap:
    name: {{ include "application.proxy.configmapName" . }}
- name: proxy-tmp
  emptyDir:
    sizeLimit: {{ $p.tmpSizeLimit }}
- name: proxy-cache
  emptyDir:
    sizeLimit: 16Mi
{{- end }}

{{- define "application.proxy.validate" -}}
{{- $v := .Values -}}
{{- $p := $v.proxy -}}
{{- if not $p.upstreamPort -}}
{{- fail "proxy.enabled requires proxy.upstreamPort — the port the app container listens on (nginx proxies to 127.0.0.1:<upstreamPort>)" -}}
{{- end -}}
{{- if eq (int $p.upstreamPort) (int $p.port) -}}
{{- fail (printf "proxy.upstreamPort (%d) equals proxy.port — nginx and the app share the pod network namespace and cannot listen on the same port" (int $p.port)) -}}
{{- end -}}
{{- range $v.extraPorts -}}
  {{- if has (int .containerPort) (list (int $p.port) (int $p.upstreamPort)) -}}
  {{- fail (printf "extraPorts[%s].containerPort %d collides with proxy.port / proxy.upstreamPort" .name (int .containerPort)) -}}
  {{- end -}}
  {{- if has .name (list "http" "app") -}}
  {{- fail (printf "extraPorts[%s]: the port names `http` (nginx) and `app` (app container) are reserved while proxy.enabled" .name) -}}
  {{- end -}}
{{- end -}}
{{- range $v.extraVolumes -}}
  {{- if has .name (list "proxy-config" "proxy-tmp" "proxy-cache") -}}
  {{- fail (printf "extraVolumes[%s]: the name is reserved for the proxy sidecar" .name) -}}
  {{- end -}}
{{- end -}}
{{- range $c := $v.extraContainers -}}
  {{- if eq $c.name "proxy" -}}
  {{- fail "extraContainers[proxy]: the name `proxy` is reserved for the proxy sidecar" -}}
  {{- end -}}
{{- end -}}
{{- if hasKey ($v.extraConfigMaps | default dict) "proxy" -}}
{{- fail "extraConfigMaps.proxy would render the same ConfigMap name as the proxy sidecar config — rename it" -}}
{{- end -}}
{{- $grace := int ($v.terminationGracePeriodSeconds | default 30) -}}
{{- $drain := int $p.shutdown.drainSeconds -}}
{{- $hold := int ($p.shutdown.appPreStopSleepSeconds | default 0) -}}
{{- if ge $drain $grace -}}
{{- fail (printf "proxy.shutdown.drainSeconds (%d) must be lower than terminationGracePeriodSeconds (%d) — nginx would be killed before it quits gracefully" $drain $grace) -}}
{{- end -}}
{{- if and (gt $hold 0) (le $hold $drain) -}}
{{- fail (printf "proxy.shutdown.appPreStopSleepSeconds (%d) must be greater than proxy.shutdown.drainSeconds (%d) — the app must outlive nginx's drain" $hold $drain) -}}
{{- end -}}
{{- if ge $hold $grace -}}
{{- fail (printf "proxy.shutdown.appPreStopSleepSeconds (%d) must be lower than terminationGracePeriodSeconds (%d)" $hold $grace) -}}
{{- end -}}
{{- end }}
