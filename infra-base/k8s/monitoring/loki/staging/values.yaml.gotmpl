# staging: only the values that differ per environment — layered after ../values.yaml.gotmpl

deploymentMode: SingleBinary
# ── SingleBinary mode (dev/staging) ─────────────────────────
singleBinary:
  replicas: 1
  persistence:
    enabled: true
    size: 50Gi
    {{- if (.Values.storageClass) }}
    storageClass: {{ (.Values.storageClass) }}
    {{- end }}
  resources:
    requests: { cpu: 200m, memory: 512Mi }
    limits:   { cpu: 1, memory: 1Gi }
# Disable scalable components in SingleBinary mode.
backend:
  replicas: 0
read:
  replicas: 0
write:
  replicas: 0

# nginx gateway — stable in-cluster entrypoint used by Grafana/Alloy.
gateway:
  replicas: 1
lokiCanary:
  enabled: false
chunksCache:
  enabled: false
resultsCache:
  enabled: false
