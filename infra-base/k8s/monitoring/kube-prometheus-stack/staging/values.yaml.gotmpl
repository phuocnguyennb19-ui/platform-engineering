# staging: only the values that differ per environment — layered after ../values.yaml.gotmpl

# ============================================================
# Prometheus Operator
# ============================================================
prometheusOperator:
  admissionWebhooks:
    patch:
      resources:
        requests: { cpu: 50m, memory: 64Mi }
        limits:   { cpu: 100m, memory: 128Mi }

# Managed control-plane (EKS/GKE/AKS) hides these endpoints — disable to
# avoid noisy "target down" alerts. Enable on self-managed clusters (prod).
kubeControllerManager:
  enabled: false
kubeScheduler:
  enabled: false
kubeEtcd:
  enabled: false
kubeProxy:
  enabled: false
